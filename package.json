{
  "name": "kiu-concept",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src next.config.ts postcss.config.mjs",
    "format:check": "prettier --check src next.config.ts postcss.config.mjs"
  },
  "dependencies": {
    "framer-motion": "13.4.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0"
}
